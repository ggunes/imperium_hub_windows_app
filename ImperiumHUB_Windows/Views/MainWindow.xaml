<Window x:Class="ImperiumGearHUB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImperiumGearHUB.Views"
        xmlns:viewmodels="clr-namespace:ImperiumGearHUB.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:ImperiumGearHUB.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Height="720" 
        Width="1280"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    
    <Window.Resources>
        <helpers:DeviceTypeToIconConverter x:Key="DeviceTypeToIconConverter"/>
        <helpers:BoolToConnectionStatusConverter x:Key="BoolToConnectionStatusConverter"/>
        <helpers:BoolToConnectionColorConverter x:Key="BoolToConnectionColorConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst Menü -->
        <materialDesign:ColorZone Mode="PrimaryDark" Padding="16" Grid.Row="0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Gamepad" Height="24" Width="24" VerticalAlignment="Center" />
                    <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Text="ImperiumGearHUB" FontSize="20" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding RefreshDevicesCommand}"
                            ToolTip="Cihazları Yenile">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                            <TextBlock Margin="4 0 0 0" Text="Cihazları Yenile" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Ana İçerik -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol Menü - Cihaz Listesi -->
            <materialDesign:Card Grid.Column="0" Margin="0 0 16 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="16" FontWeight="Bold" FontSize="16" Text="Cihazlar" />
                    
                    <StackPanel DockPanel.Dock="Bottom" Margin="16">
                        <Button Margin="0 8" Content="Bağlan" 
                                Command="{Binding ConnectDeviceCommand}" 
                                IsEnabled="{Binding SelectedDevice.IsConnected, Converter={StaticResource BooleanToInvertedBooleanConverter}}" />
                        <Button Margin="0 8" Content="Bağlantıyı Kes" 
                                Command="{Binding DisconnectDeviceCommand}" 
                                IsEnabled="{Binding SelectedDevice.IsConnected}" />
                        <Button Margin="0 8" Content="Cihaz Bilgisi Al" 
                                Command="{Binding GetDeviceInfoCommand}" 
                                IsEnabled="{Binding SelectedDevice.IsConnected}" />
                    </StackPanel>
                    
                    <ListView ItemsSource="{Binding Devices}" 
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              Margin="8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <materialDesign:PackIcon Grid.Column="0" 
                                                             Kind="{Binding Type, Converter={StaticResource DeviceTypeToIconConverter}}" 
                                                             Width="32" Height="32" 
                                                             VerticalAlignment="Center" 
                                                             Margin="0 0 16 0" />
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToConnectionStatusConverter}}" 
                                                   Foreground="{Binding IsConnected, Converter={StaticResource BoolToConnectionColorConverter}}" 
                                                   FontSize="12" Margin="0 4 0 0" />
                                        <TextBlock Text="{Binding FirmwareVersion, StringFormat=Firmware: {0}}" 
                                                   Visibility="{Binding FirmwareVersion, Converter={StaticResource StringToVisibilityConverter}}"
                                                   FontSize="12" Margin="0 4 0 0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </materialDesign:Card>

            <!-- Sağ İçerik - Cihaz Ayarları -->
            <materialDesign:Card Grid.Column="1">
                <Grid>
                    <!-- Cihaz seçilmediğinde gösterilecek içerik -->
                    <TextBlock Text="Lütfen sol menüden bir cihaz seçin" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontSize="18" 
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisibilityConverter}}" />
                    
                    <!-- Cihaz seçildiğinde gösterilecek içerik -->
                    <TabControl Margin="16" 
                                Visibility="{Binding SelectedDevice, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <!-- Klavye için sekmeler -->
                        <TabItem Header="RGB Ayarları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToKeyboardVisibilityConverter}}">
                            <TextBlock Text="RGB Ayarları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="Tuş Atamaları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToKeyboardVisibilityConverter}}">
                            <TextBlock Text="Tuş Atamaları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="Hall Effect Ayarları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToKeyboardVisibilityConverter}}">
                            <TextBlock Text="Hall Effect Ayarları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        
                        <!-- Mouse için sekmeler -->
                        <TabItem Header="DPI Ayarları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToMouseVisibilityConverter}}">
                            <TextBlock Text="DPI Ayarları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="RGB Ayarları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToMouseVisibilityConverter}}">
                            <TextBlock Text="RGB Ayarları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="Tuş Atamaları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToMouseVisibilityConverter}}">
                            <TextBlock Text="Tuş Atamaları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="Sensör Ayarları" 
                                 Visibility="{Binding SelectedDevice.Type, Converter={StaticResource DeviceTypeToMouseVisibilityConverter}}">
                            <TextBlock Text="Sensör Ayarları içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        
                        <!-- Ortak sekmeler -->
                        <TabItem Header="Makro Editörü">
                            <TextBlock Text="Makro Editörü içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="Profil Yöneticisi">
                            <TextBlock Text="Profil Yöneticisi içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                        <TabItem Header="Firmware Güncelleme">
                            <TextBlock Text="Firmware Güncelleme içeriği burada olacak" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Alt Bilgi Çubuğu -->
        <materialDesign:ColorZone Mode="PrimaryLight" Grid.Row="2" Padding="8">
            <DockPanel>
                <TextBlock Text="{Binding IsBusy, Converter={StaticResource BoolToStatusTextConverter}}" 
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                           VerticalAlignment="Center" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Imperium Gaming Gear" VerticalAlignment="Center" />
                    <materialDesign:PackIcon Kind="Copyright" Margin="8 0" VerticalAlignment="Center" />
                    <TextBlock Text="2023" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>