<UserControl x:Class="ImperiumGearHUB.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImperiumGearHUB.Views"
             xmlns:converters="clr-namespace:ImperiumGearHUB.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Başlık -->
        <TextBlock Grid.Row="0" Text="Klavye Ayarları" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
        
        <!-- Ana İçerik -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- RGB Ayarları Sekmesi -->
            <TabItem Header="RGB Ayarları">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- RGB Efekt Modu -->
                    <GroupBox Grid.Row="0" Header="RGB Efekt Modu" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <RadioButton Content="Kapalı" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Off}" Margin="0,5"/>
                            <RadioButton Content="Statik" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Static}" Margin="0,5"/>
                            <RadioButton Content="Nefes Alma" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Breathing}" Margin="0,5"/>
                            <RadioButton Content="Renk Döngüsü" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ColorCycle}" Margin="0,5"/>
                            <RadioButton Content="Dalga" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Wave}" Margin="0,5"/>
                            <RadioButton Content="Reaktif" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Reactive}" Margin="0,5"/>
                            <RadioButton Content="Dalgalanma" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Ripple}" Margin="0,5"/>
                            <RadioButton Content="Yıldız Işığı" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Starlight}" Margin="0,5"/>
                            <RadioButton Content="Yağmur" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rain}" Margin="0,5"/>
                            <RadioButton Content="Özel" IsChecked="{Binding SelectedRgbMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Custom}" Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Renk Seçimi -->
                    <GroupBox Grid.Row="1" Header="Renk Seçimi" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Kırmızı:" Width="60"/>
                                    <Slider Value="{Binding RedValue}" Minimum="0" Maximum="255" Width="200" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding RedValue}" Width="30"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Yeşil:" Width="60"/>
                                    <Slider Value="{Binding GreenValue}" Minimum="0" Maximum="255" Width="200" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding GreenValue}" Width="30"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Mavi:" Width="60"/>
                                    <Slider Value="{Binding BlueValue}" Minimum="0" Maximum="255" Width="200" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding BlueValue}" Width="30"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <Rectangle Grid.Column="1" Width="60" Height="60" Fill="{Binding SelectedColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" StrokeThickness="1"/>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Hız ve Parlaklık -->
                    <GroupBox Grid.Row="2" Header="Hız ve Parlaklık" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Hız:" Width="60"/>
                                <Slider Value="{Binding SpeedValue}" Minimum="1" Maximum="10" Width="200" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SpeedValue}" Width="30"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Parlaklık:" Width="60"/>
                                <Slider Value="{Binding BrightnessValue}" Minimum="0" Maximum="100" Width="200" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding BrightnessValue}" Width="30"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Uygula Butonu -->
                    <Button Grid.Row="3" Content="Uygula" Command="{Binding ApplyRgbSettingsCommand}" HorizontalAlignment="Left" Margin="10" Width="100"/>
                </Grid>
            </TabItem>
            
            <!-- Tuş Ayarları Sekmesi -->
            <TabItem Header="Tuş Ayarları">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Hall Effect Ayarları -->
                    <GroupBox Grid.Row="0" Header="Hall Effect Ayarları" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Aktüasyon Noktası:" Width="120"/>
                                <Slider Value="{Binding ActuationPoint}" Minimum="1" Maximum="4" Width="200" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ActuationPoint}" Width="30"/>
                            </StackPanel>
                            
                            <CheckBox Content="Rapid Trigger" IsChecked="{Binding RapidTriggerEnabled}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Tuş Haritası -->
                    <GroupBox Grid.Row="1" Header="Tuş Haritası" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Tuş haritası özelliği yakında eklenecek." VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Tuş Haritası Düzenle" IsEnabled="False"/>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Uygula Butonu -->
                    <Button Grid.Row="2" Content="Uygula" Command="{Binding ApplyKeySettingsCommand}" HorizontalAlignment="Left" Margin="10" Width="100"/>
                </Grid>
            </TabItem>
            
            <!-- Profil Yönetimi Sekmesi -->
            <TabItem Header="Profil Yönetimi">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Profil Seçimi -->
                    <GroupBox Grid.Row="0" Header="Profil Seçimi" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Yeni" Command="{Binding NewProfileCommand}" Margin="0,0,5,0" Width="60"/>
                                <Button Content="Sil" Command="{Binding DeleteProfileCommand}" Width="60"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Profil Detayları -->
                    <GroupBox Grid.Row="1" Header="Profil Detayları" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Profil Adı:" Width="80"/>
                                <TextBox Text="{Binding SelectedProfile.Name}" Width="200"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Açıklama:" Width="80" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding SelectedProfile.Description}" Width="300" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>
                            
                            <CheckBox Grid.Row="2" Content="Varsayılan profil olarak ayarla" IsChecked="{Binding SelectedProfile.IsDefault}" Margin="0,10,0,0"/>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Profil İşlemleri -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                        <Button Content="Kaydet" Command="{Binding SaveProfileCommand}" Margin="0,0,5,0" Width="80"/>
                        <Button Content="Yükle" Command="{Binding LoadProfileCommand}" Margin="0,0,5,0" Width="80"/>
                        <Button Content="Dışa Aktar" Command="{Binding ExportProfileCommand}" Margin="0,0,5,0" Width="80"/>
                        <Button Content="İçe Aktar" Command="{Binding ImportProfileCommand}" Width="80"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>