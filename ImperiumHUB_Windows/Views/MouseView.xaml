<UserControl x:Class="ImperiumGearHUB.Views.MouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImperiumGearHUB.Views"
             xmlns:viewmodels="clr-namespace:ImperiumGearHUB.ViewModels"
             xmlns:converters="clr-namespace:ImperiumGearHUB.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:MouseViewModel}">
    
    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Başlık -->
        <TextBlock Grid.Row="0" Text="Fare Ayarları" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- Ana İçerik -->
        <TabControl Grid.Row="1">
            <!-- DPI Ayarları Sekmesi -->
            <TabItem Header="DPI Ayarları">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- DPI Seviyesi Seçimi -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="DPI Seviyesi" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding DpiSettings}" 
                                      SelectedItem="{Binding SelectedDpiSetting}"
                                      DisplayMemberPath="Level"
                                      Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <!-- Seçili DPI Seviyesi Ayarları -->
                        <GroupBox Grid.Row="1" Header="DPI Değeri" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding SelectedDpiSetting.DpiValue, StringFormat={}Mevcut DPI: {0}}" Margin="0,0,0,10"/>
                                <Slider Minimum="100" Maximum="16000" 
                                        Value="{Binding SelectedDpiSetting.DpiValue}" 
                                        TickFrequency="100" 
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SelectedDpiSetting.DpiValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- DPI Renk Ayarları -->
                        <GroupBox Grid.Row="2" Header="DPI Renk Ayarları" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Renk Önizleme -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                                        Background="{Binding SelectedDpiSetting.Color, Converter={StaticResource ColorToBrushConverter}}" 
                                        Width="100" Height="50" Margin="0,0,0,10"/>
                                
                                <!-- Kırmızı -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Kırmızı:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding SelectedDpiSetting.Red}" Margin="10,0"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDpiSetting.Red, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                                
                                <!-- Yeşil -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Yeşil:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding SelectedDpiSetting.Green}" Margin="10,0"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SelectedDpiSetting.Green, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                                
                                <!-- Mavi -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mavi:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding SelectedDpiSetting.Blue}" Margin="10,0"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SelectedDpiSetting.Blue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                            </Grid>
                        </GroupBox>
                        
                        <!-- Renk Seçici -->
                        <GroupBox Grid.Row="3" Header="Renk Seçici" Margin="0,0,0,20">
                            <xctk:ColorPicker SelectedColor="{Binding SelectedDpiSetting.Color}" 
                                              Width="200" HorizontalAlignment="Left" Margin="10"/>
                        </GroupBox>
                        
                        <!-- Uygula Butonu -->
                        <Button Grid.Row="4" Content="DPI Ayarlarını Uygula" 
                                Command="{Binding ApplyDpiSettingsCommand}" 
                                Width="200" HorizontalAlignment="Left"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <!-- Polling Rate Ayarları Sekmesi -->
            <TabItem Header="Polling Rate">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <GroupBox Grid.Row="0" Header="Polling Rate Seçimi" Margin="0,0,0,20">
                        <StackPanel Margin="10">
                            <RadioButton Content="125 Hz" 
                                         IsChecked="{Binding SelectedPollingRate, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rate125Hz}"
                                         Margin="0,5"/>
                            <RadioButton Content="250 Hz" 
                                         IsChecked="{Binding SelectedPollingRate, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rate250Hz}"
                                         Margin="0,5"/>
                            <RadioButton Content="500 Hz" 
                                         IsChecked="{Binding SelectedPollingRate, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rate500Hz}"
                                         Margin="0,5"/>
                            <RadioButton Content="1000 Hz" 
                                         IsChecked="{Binding SelectedPollingRate, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rate1000Hz}"
                                         Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <Button Grid.Row="1" Content="Polling Rate Ayarlarını Uygula" 
                            Command="{Binding ApplyPollingRateCommand}" 
                            Width="250" HorizontalAlignment="Left"/>
                </Grid>
            </TabItem>
            
            <!-- Sensör Ayarları Sekmesi -->
            <TabItem Header="Sensör Ayarları">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- LOD Ayarları -->
                        <GroupBox Grid.Row="0" Header="Lift-Off Distance (LOD)" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <RadioButton Content="Düşük" 
                                             IsChecked="{Binding SelectedLodSetting, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Low}"
                                             Margin="0,5"/>
                                <RadioButton Content="Orta" 
                                             IsChecked="{Binding SelectedLodSetting, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Medium}"
                                             Margin="0,5"/>
                                <RadioButton Content="Yüksek" 
                                             IsChecked="{Binding SelectedLodSetting, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=High}"
                                             Margin="0,5"/>
                                <Button Content="LOD Ayarlarını Uygula" 
                                        Command="{Binding ApplyLodSettingCommand}" 
                                        Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Angle Snapping -->
                        <GroupBox Grid.Row="1" Header="Angle Snapping" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox Content="Angle Snapping Etkinleştir" 
                                          IsChecked="{Binding AngleSnappingEnabled}" 
                                          Margin="0,5"/>
                                <TextBlock Text="Angle Snapping, fare hareketlerini düzleştirerek daha düz çizgiler çizmenizi sağlar. Oyunlarda hassas nişan almak için kapalı tutmanız önerilir." 
                                           TextWrapping="Wrap" Margin="0,5"/>
                                <Button Content="Angle Snapping Ayarlarını Uygula" 
                                        Command="{Binding ApplyAngleSnappingCommand}" 
                                        Width="250" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Debounce Time -->
                        <GroupBox Grid.Row="2" Header="Debounce Time" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding DebounceTime, StringFormat={}Mevcut Değer: {0} ms}" Margin="0,0,0,10"/>
                                <Slider Minimum="0" Maximum="20" 
                                        Value="{Binding DebounceTime}" 
                                        TickFrequency="1" 
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,0,5"/>
                                <TextBlock Text="Debounce Time, tuşa basıldıktan sonra tekrar algılanması için geçmesi gereken süredir. Düşük değerler daha hızlı tepki sağlar ancak yanlışlıkla çift tıklama olasılığını artırabilir." 
                                           TextWrapping="Wrap" Margin="0,5"/>
                                <Button Content="Debounce Time Ayarlarını Uygula" 
                                        Command="{Binding ApplyDebounceTimeCommand}" 
                                        Width="250" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <!-- RGB Ayarları Sekmesi -->
            <TabItem Header="RGB Ayarları">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- RGB Efekt Modu -->
                        <GroupBox Grid.Row="0" Header="RGB Efekt Modu" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <ComboBox ItemsSource="{Binding Source={x:Static viewmodels:DeviceCommands.RGBEffectModes}}" 
                                          SelectedItem="{Binding SelectedRgbMode}"
                                          Width="200" HorizontalAlignment="Left" Margin="0,5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- RGB Renk Ayarları -->
                        <GroupBox Grid.Row="1" Header="RGB Renk Ayarları" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Renk Önizleme -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                                        Background="{Binding SelectedColor, Converter={StaticResource ColorToBrushConverter}}" 
                                        Width="100" Height="50" Margin="0,0,0,10"/>
                                
                                <!-- Kırmızı -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Kırmızı:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding RedValue}" Margin="10,0"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding RedValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                                
                                <!-- Yeşil -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Yeşil:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding GreenValue}" Margin="10,0"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding GreenValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                                
                                <!-- Mavi -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mavi:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding BlueValue}" Margin="10,0"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding BlueValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                            </Grid>
                        </GroupBox>
                        
                        <!-- RGB Hız ve Parlaklık Ayarları -->
                        <GroupBox Grid.Row="2" Header="Hız ve Parlaklık" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Hız -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hız:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding SpeedValue}" Margin="10,0"/>
                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SpeedValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                                
                                <!-- Parlaklık -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Parlaklık:" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" 
                                        Value="{Binding BrightnessValue}" Margin="10,0"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding BrightnessValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50"/>
                            </Grid>
                        </GroupBox>
                        
                        <!-- Renk Seçici ve Uygula Butonu -->
                        <GroupBox Grid.Row="3" Header="Renk Seçici" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <xctk:ColorPicker SelectedColor="{Binding SelectedColor}" 
                                                 Width="200" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <Button Content="RGB Ayarlarını Uygula" 
                                        Command="{Binding ApplyRgbSettingsCommand}" 
                                        Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            <!-- Profil Yönetimi Sekmesi -->
            <TabItem Header="Profil Yönetimi">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Profil Seçimi -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Mevcut Profil" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Profiles}" 
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name"
                                  Width="300" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Profili Yükle" 
                                    Command="{Binding LoadProfileCommand}" 
                                    Width="100" Margin="0,0,10,0"/>
                            <Button Content="Profili Kaydet" 
                                    Command="{Binding SaveProfileCommand}" 
                                    Width="100" Margin="0,0,10,0"/>
                            <Button Content="Yeni Profil" 
                                    Command="{Binding CreateProfileCommand}" 
                                    Width="100" Margin="0,0,10,0"/>
                            <Button Content="Profili Sil" 
                                    Command="{Binding DeleteProfileCommand}" 
                                    Width="100" Margin="0,0,10,0"/>
                            <Button Content="Profili Kopyala" 
                                    Command="{Binding CloneProfileCommand}" 
                                    Width="100"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Profil Detayları -->
                    <GroupBox Grid.Row="1" Header="Profil Detayları" Margin="0,0,0,20">
                        <Grid Margin="10" IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBooleanConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Profil Adı -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Profil Adı:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                            
                            <!-- Profil Açıklaması -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Açıklama:" VerticalAlignment="Top" Margin="0,0,10,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}" 
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,5"/>
                            
                            <!-- Varsayılan Profil -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Varsayılan:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding SelectedProfile.IsDefault}" 
                                      Content="Bu profili varsayılan olarak ayarla"/>
                        </Grid>
                    </GroupBox>
                    
                    <!-- İçe/Dışa Aktarma -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Profili Dışa Aktar" 
                                Command="{Binding ExportProfileCommand}" 
                                Width="150" Margin="0,0,10,0"/>
                        <Button Content="Profili İçe Aktar" 
                                Command="{Binding ImportProfileCommand}" 
                                Width="150"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>